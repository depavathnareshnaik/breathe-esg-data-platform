# Django Settings
SECRET_KEY=generate-a-secure-random-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# Database configuration (Railway automatically provides DATABASE_URL in production)
# For local development with PostgreSQL:
DATABASE_URL=postgresql://esg_user:esg_password@localhost:5432/esg_db

# CORS Allowed Origins (Comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-deployment.vercel.app
